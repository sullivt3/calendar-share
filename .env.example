DATABASE_URL=postgresql://calendar:calendar@localhost:5432/calendar_share?schema=public
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Development seed only. Choose at least 12 characters; never use production credentials.
DEMO_PASSWORD=

# Local-only sample calendars; always disabled in production.
ENABLE_MOCK_CALENDARS=true
