DATABASE_URL=postgresql://calendar:calendar@localhost:5432/calendar_share?schema=public
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Development seed only. Choose at least 12 characters; never use production credentials.
DEMO_PASSWORD=

# Local-only sample calendars; always disabled in production.
ENABLE_MOCK_CALENDARS=true

# Optional Google integration. Leave blank to show an honest unconfigured state.
# See docs/GOOGLE_SETUP.md. Server-only; never use NEXT_PUBLIC_ for these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate an independent 32-byte key with openssl rand -base64 32.
PROVIDER_ENCRYPTION_KEY_ID=v1
PROVIDER_ENCRYPTION_KEYS=
# Optional public HTTPS endpoint; without it, reconciliation runs every 15 minutes.
GOOGLE_WEBHOOK_URL=
