generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   SharedSpaceMember[]
  connections   ProviderConnection[]
  preference    UserPreference?
  oauthAttempts OAuthAttempt[]
  @@map("users")
}
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAttempts OAuthAttempt[]
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verifications")
}
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
  @@map("rate_limits")
}

enum SharingMode {
  NOT_SHARED
  BUSY_ONLY
  FULL_DETAILS
}
enum Provider {
  GOOGLE
  MICROSOFT
  APPLE
  MOCK
}
model SharedSpace {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime @default(now())
  members     SharedSpaceMember[]
  invitations Invitation[]
  shares      CalendarShare[]
  @@map("shared_spaces")
}
model SharedSpaceMember {
  spaceId  String @db.Uuid
  userId   String @db.Uuid
  joinedAt DateTime @default(now())
  space    SharedSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([spaceId, userId])
  @@index([userId])
  @@map("shared_space_members")
}
model Invitation {
  id        String @id @default(uuid()) @db.Uuid
  spaceId   String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  space     SharedSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  @@index([spaceId])
  @@map("invitations")
}
// Provider credentials remain encrypted and are never serialized to clients.
model ProviderConnection {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  provider   Provider
  externalId String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendars  Calendar[]
  accountLabel String?
  status ConnectionStatus @default(CONNECTED)
  credentialCiphertext String?
  grantedScopes String?
  lastErrorCode String?
  nextDiscoveryAt DateTime @default(now())
  nextAllowedAt DateTime @default(now())
  lastManualSyncAt DateTime?
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  jobs SyncJob[]
  subscriptions SyncSubscription[]
  @@index([provider, status, nextDiscoveryAt])
  @@unique([userId, provider, externalId])
  @@map("provider_connections")
}
model Calendar {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid
  externalId   String
  name         String
  connection   ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  shares       CalendarShare[]
  events       Event[]
  mockProvider Provider?
  lastSyncedAt DateTime?
  timeZone String @default("UTC")
  isPrimary Boolean @default(false)
  isEnabled Boolean @default(true)
  syncEnabled Boolean @default(false)
  nextSyncAt DateTime @default(now())
  nextWatchAt DateTime @default(now())
  lastErrorCode String?
  syncState SyncState?
  sourceEvents SourceEvent[]
  subscriptions SyncSubscription[]
  jobs SyncJob[]
  @@index([syncEnabled, nextSyncAt])
  @@unique([connectionId, externalId])
  @@map("calendars")
}
model CalendarShare {
  calendarId String @db.Uuid
  spaceId    String @db.Uuid
  mode       SharingMode @default(NOT_SHARED)
  includeDescription Boolean @default(false)
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  space      SharedSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  @@id([calendarId, spaceId])
  @@index([spaceId])
  @@map("calendar_shares")
}

enum EventPrivacy {
  PUBLIC
  PRIVATE
  CONFIDENTIAL
}
model Event {
  id             String @id @default(uuid()) @db.Uuid
  calendarId     String @db.Uuid
  externalId     String
  title          String
  start          DateTime @db.Timestamptz(3)
  end            DateTime @db.Timestamptz(3)
  allDay         Boolean @default(false)
  timeZone       String @default("UTC")
  location       String?
  description    String?
  privacy        EventPrivacy @default(PRIVATE)
  busy           Boolean @default(true)
  cancelled      Boolean @default(false)
  recurrenceRule String?
  seriesId       String?
  originalStart  DateTime? @db.Timestamptz(3)
  exceptions     Json?
  providerVersion String?
  updatedAt      DateTime @updatedAt
  calendar       Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  @@unique([calendarId, externalId])
  @@index([calendarId, start, end])
  @@map("events")
}
model UserPreference {
  userId       String @id @db.Uuid
  displayColor String?
  theme        String @default("SYSTEM")
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_preferences")
}

enum ConnectionStatus {
  CONNECTED
  ERROR
  REAUTH_REQUIRED
  DISCONNECTING
  DISCONNECTED
}
enum SyncJobKind {
  DISCOVER
  SYNC
  WATCH
  DISCONNECT
}
enum SyncJobStatus {
  PENDING
  RUNNING
  FAILED
}
enum SyncPhase {
  IDLE
  FETCH
  MATERIALIZE
}
model OAuthAttempt {
  provider Provider @default(GOOGLE)
  nonceHash String?
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  sessionId String @db.Uuid
  stateHash String @unique
  browserHash String
  verifierCiphertext String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("oauth_attempts")
}
model SyncState {
  calendarId String @id @db.Uuid
  phase SyncPhase @default(IDLE)
  syncTokenCiphertext String?
  pageTokenCiphertext String?
  pendingTokenCiphertext String?
  snapshotId String? @db.Uuid
  fullSync Boolean @default(false)
  pageCount Int @default(0)
  targetWindowStart DateTime?
  targetWindowEnd DateTime?
  windowStart DateTime?
  windowEnd DateTime?
  lastSuccessAt DateTime?
  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  @@map("sync_states")
}
model SourceEvent {
  id String @id @default(uuid()) @db.Uuid
  calendarId String @db.Uuid
  externalId String
  payload Json
  snapshotId String? @db.Uuid
  dirty Boolean @default(true)
  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  @@unique([calendarId, externalId])
  @@index([calendarId, dirty])
  @@map("source_events")
}
model SyncJob {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid
  calendarId String? @db.Uuid
  kind SyncJobKind
  dedupeKey String @unique
  status SyncJobStatus @default(PENDING)
  runAt DateTime @default(now())
  attempts Int @default(0)
  requestVersion Int @default(1)
  claimedVersion Int @default(0)
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  lastErrorCode String?
  updatedAt DateTime @updatedAt
  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  calendar Calendar? @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  @@index([status, runAt])
  @@map("sync_jobs")
}
model SyncSubscription {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid
  calendarId String @db.Uuid
  tokenHash String
  resourceId String?
  expiresAt DateTime
  status String @default("PENDING")
  lastMessage BigInt @default(0)
  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  @@index([calendarId, expiresAt])
  @@map("sync_subscriptions")
}
