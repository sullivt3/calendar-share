generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   SharedSpaceMember[]
  connections   ProviderConnection[]
  @@map("users")
}
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verifications")
}
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
  @@map("rate_limits")
}

enum SharingMode {
  NOT_SHARED
  BUSY_ONLY
  FULL_DETAILS
}
enum Provider {
  GOOGLE
  MICROSOFT
  APPLE
  MOCK
}
model SharedSpace {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime @default(now())
  members     SharedSpaceMember[]
  invitations Invitation[]
  shares      CalendarShare[]
  @@map("shared_spaces")
}
model SharedSpaceMember {
  spaceId  String @db.Uuid
  userId   String @db.Uuid
  joinedAt DateTime @default(now())
  space    SharedSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([spaceId, userId])
  @@index([userId])
  @@map("shared_space_members")
}
model Invitation {
  id        String @id @default(uuid()) @db.Uuid
  spaceId   String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  space     SharedSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  @@index([spaceId])
  @@map("invitations")
}
// Metadata only in Phase 2. Credential storage and connection APIs arrive later.
model ProviderConnection {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  provider   Provider
  externalId String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendars  Calendar[]
  @@unique([userId, provider, externalId])
  @@map("provider_connections")
}
model Calendar {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid
  externalId   String
  name         String
  connection   ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  shares       CalendarShare[]
  @@unique([connectionId, externalId])
  @@map("calendars")
}
model CalendarShare {
  calendarId String @db.Uuid
  spaceId    String @db.Uuid
  mode       SharingMode @default(NOT_SHARED)
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  space      SharedSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  @@id([calendarId, spaceId])
  @@index([spaceId])
  @@map("calendar_shares")
}
